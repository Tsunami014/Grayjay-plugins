{
  "name": "YouTube Music",
  "description": "A new music service with official albums, singles, videos, remixes, live performances and more",
  "author": "Tsunami014",
  "authorUrl": "https://tsunami014.github.io",
  "platformUrl": "https://music.youtube.com",
  "sourceUrl": "https://tsunami014.github.io/Grayjay-plugins/YTMusicConfig.json",
  "repositoryUrl": "https://github.com/Tsunami014/Grayjay-plugins",
  "scriptUrl": "./YTMusicScript.js",
  "version": 4,
  "iconUrl": "./YTMusic.png",
  "id": "ff7fee60-202f-4aeb-a270-676862dd854b",
  "scriptSignature": "",
  "scriptPublicKey": "",
  "packages": [
    "Http"
  ],
  "allowEval": false,
  "allowUrls": [
    "music.youtube.com",
    "youtube.com",
    "www.youtube.com"
  ],
  "supportedClaimTypes": [
    3
  ],
  "authentication": {
    "completionUrl": "https://music.youtube.com/",
    "userAgent": "Mozilla/5.0 (Linux; Android 12) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.6099.230 Mobile Safari/537.36",
    "loginUrl": "https://accounts.google.com/ServiceLogin?ltmpl=music&service=youtube&uilel=3&passive=true&continue=https%3A%2F%2Fmusic.youtube.com%2Fsignin%3Faction_handle_signin%3Dtrue%26app%3Ddesktop%26hl%3Den%26next%3Dhttps%253A%252F%252Fwww.youtube.com%252Fchannel_switcher&hl=en&ec=65620",
    "cookiesToFind": [
      "SIDCC"
    ],
    "cookiesExclOthers": false,
    "headersToFind": [
      "authorization"
    ],
    "domainHeadersToFind": {
      ".youtube.com": [
        "authorization"
      ]
    },
    "loginWarning": "You must select a profile after login for authentication to complete."
  },
  "settings": [
    {
      "variable": "header",
      "name": "Loader",
      "description": "Change which algorithm loads specific parts of the app. Faster algorithm may not have as much information (e.g. author name may be missing).\nThe `Everything` option loads everything, which is very slow.\nThe Most things loads at a medium speed and loads everything but the thumbnails on the authours, which is why it is recommended\nAnd Just the necesities loads really fast, but only loads the picture, the title of the song and half the time the author name. Other things will be missing",
      "type": "Header"
    },
    {
      "variable": "HomePageType",
      "name": "Home Page Loader",
      "description": "Change the home page loader algorithm",
      "type": "Dropdown",
      "default": "1",
      "options": [
        "Everything (slow)",
        "Most things (recommended)",
        "Just the necesities (fast)"
      ]
    },
    {
      "variable": "SearchPageType",
      "name": "Search Page Loader",
      "description": "Change the search page loader algorithm (when you search for a song)",
      "type": "Dropdown",
      "default": "1",
      "options": [
        "Everything (slow)",
        "Most things (recommended)",
        "Just the necesities (fast)"
      ]
    }
  ]
}
